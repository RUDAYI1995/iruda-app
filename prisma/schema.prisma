generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAVELER
  GUIDE
  BOTH
}

enum Gender {
  MALE
  FEMALE
}

enum BroadCategory {
  CONFORMIST // 동조형
  SMALL_TALK // 스몰톡형
  COHABITANT // 공동생활형
  TRANSIT_ONLY // 이동동행형
}

enum GuideApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum ReadyRoomStatus {
  WAITING
  READY_CHECK
  CONFIRMED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(TRAVELER)
  gender       Gender?
  exp          Float    @default(0)
  mileage      Int      @default(0)
  phoneVerified Boolean @default(false)
  isOperator    Boolean  @default(false)
  createdAt    DateTime @default(now())

  personalityProfile PersonalityProfile?
  guideProfile        GuideProfile?
  meetupMembers       MeetupMember[]
  readyRoomParticipants ReadyRoomParticipant[]
  bookingsAsTraveler  GuideBooking[]        @relation("TravelerBookings")
  posts               Post[]
  comments            Comment[]
  sentMessages        Message[]             @relation("SentMessages")
  conversationsA      Conversation[]        @relation("ConversationUserA")
  conversationsB      Conversation[]        @relation("ConversationUserB")
  reviewsWritten      Review[]              @relation("ReviewAuthor")
  reportsFiled        Report[]              @relation("ReportAuthor")
  reportsReceived     Report[]              @relation("ReportTarget")
  attractionsAdded    Attraction[]
  attractionFavorites AttractionFavorite[]
  animalCompanionRequest AnimalCompanionRequest?
  groupChatMembers    GroupChatMember[]
  groupMessages       GroupMessage[]
  createdGroupChats   GroupChat[]           @relation("GroupChatCreator")
  createdCheckpoints  QuestCheckpoint[]
  checkpointVerifications QuestCheckpointVerification[]
  inventoryItems      InventoryItem[]

  partiesLed          Party[]        @relation("PartyLeader")
  partyMembership     PartyMember?
  sentPartyInvites     PartyInvite[] @relation("PartyInviteFrom")
  receivedPartyInvites PartyInvite[] @relation("PartyInviteTo")
  friendsOf           Friendship[]  @relation("FriendshipUser")
  friendedBy          Friendship[]  @relation("FriendshipFriend")
  pushSubscriptions   PushSubscription[]
  carePlans           CarePlan[]
  scheduledNotificationsReceived ScheduledNotification[] @relation("ScheduledNotificationRecipient")
  scheduledNotificationsCreated  ScheduledNotification[] @relation("ScheduledNotificationCreator")
  nightMarketStall NightMarketStall?
  rudaVotesRequested RudaVote[] @relation("RudaVoteRequester")
  rudaVoteBallots    RudaVoteBallot[]
  adventureMissionProgress AdventureMissionProgress[]
  closenessFrom      Closeness[] @relation("ClosenessFrom")
  mood               UserMood?
  dungeonStagesCleared DungeonStageProgress[]
}

// 위대한 모험(루다대륙) 관광 야시장 — 대구시간(KST) 20:00~06:00에만 열리는 가상 시장.
// 유저 한 명당 하나의 가상 점포를 만들고 꾸밀 수 있음.
model NightMarketStall {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  owner       User     @relation(fields: [ownerId], references: [id])
  name        String
  emoji       String   @default("🏮")
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 루다알림제 — 지정한 시각에 발송되는 예약 알림. 파티장이 특정 파티원에게 보내는 알림과,
// 누구나(파티 소속 여부 무관) 스스로 설정하는 개인 알림 둘 다 이 모델을 씀.
model ScheduledNotification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("ScheduledNotificationRecipient", fields: [userId], references: [id])
  createdById String
  createdBy   User     @relation("ScheduledNotificationCreator", fields: [createdById], references: [id])
  title       String
  body        String
  sendAt      DateTime
  sent        Boolean  @default(false)
  createdAt   DateTime @default(now())
  items       Json? // AI가 본문에서 찾아낸 {keyword, emoji} 목록 — 생성 시 한 번만 계산해서 저장
}

// 소심케어제 — 유저가 고민과 케어 종료일을 지정하면 AI루다가 단계별 케어 계획을 만들고,
// 종료일까지 하루 3번(cron) 알림으로 그날의 케어 단계를 보내줌.
model CarePlan {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  topic        String // heart / travel / relationship / courage
  concern      String // 유저가 적은 고민 내용
  untilDate    String // "YYYY-MM-DD" — 케어 필요 날짜(종료일)
  steps        Json // AI가 생성한 단계별 케어 문구 배열 (하루 1단계)
  currentStep  Int      @default(0)
  sentToday    Int      @default(0)
  lastSentDate String? // "YYYY-MM-DD" — 마지막으로 알림을 보낸 날짜(하루 3회 카운트 리셋 기준)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// 루다알림제 — 브라우저 Web Push 구독 정보. 기기(엔드포인트)별로 하나씩 저장됨.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// 루다월드 전역에서 통하는 파티 시스템 — 정모/일정등록 등 어디서든 같은 파티 개념을 씀.
// 한 사람은 동시에 하나의 파티에만 속함(PartyMember.userId가 @unique).
model Party {
  id          String    @id @default(cuid())
  leaderId    String
  leader      User      @relation("PartyLeader", fields: [leaderId], references: [id])
  createdAt   DateTime  @default(now())

  // 파티장이 채워두는 간단한 여행 일정표 — "여행준비 알림 보내기"가 이걸 참고해서 요약함
  destination String?
  departureAt DateTime?
  notes       String?

  members  PartyMember[]
  invites  PartyInvite[]
}

model PartyMember {
  id       String   @id @default(cuid())
  partyId  String
  party    Party    @relation(fields: [partyId], references: [id])
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id])
  joinedAt DateTime @default(now())
}

// 파티장이 비파티원인 특정 유저에게 보내는 파티 제안. 대상이 수락/거절할 때까지 PENDING.
model PartyInvite {
  id         String   @id @default(cuid())
  partyId    String
  party      Party    @relation(fields: [partyId], references: [id])
  fromUserId String
  fromUser   User     @relation("PartyInviteFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("PartyInviteTo", fields: [toUserId], references: [id])
  status     String   @default("PENDING") // PENDING / ACCEPTED / DECLINED
  createdAt  DateTime @default(now())

  @@unique([partyId, toUserId])
}

// 친구 추가 — 즉시 성립(양방향으로 두 행 생성)
model Friendship {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("FriendshipUser", fields: [userId], references: [id])
  friendId  String
  friend    User     @relation("FriendshipFriend", fields: [friendId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
}

// 해외 교통정보 추천을 조회할 때 같은 날짜/도시로 떠나는 다른 유저를 찾기 위한 기록
model TransitPlan {
  id         String   @id @default(cuid())
  userId     String
  city       String
  hotel      String
  travelDate String // "YYYY-MM-DD"
  travelTime String // "HH:mm"
  createdAt  DateTime @default(now())
}

// 실시간 여행게임 대전의 승리 기록 — 이벤트 랭킹(예: 최고의 연극상) 집계와 EXP/마일리지 지급 이력에 사용
model GameWinLog {
  id        String   @id @default(cuid())
  userId    String
  gameType  String // 예: "FACE_OFF"
  createdAt DateTime @default(now())
}

// 이벤트 랭킹보드에서 부정행위가 적발된 유저를 제외 처리 — eventKey별로 제외
model EventDisqualification {
  id          String   @id @default(cuid())
  eventKey    String
  userId      String
  reason      String?
  createdById String
  createdAt   DateTime @default(now())

  @@unique([eventKey, userId])
}

// 상점 아이템 카탈로그는 코드(src/lib/shopItems.ts)에 정적으로 정의 — itemId로 참조만 함
model InventoryItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  itemId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
}

model PersonalityProfile {
  id                 String        @id @default(cuid())
  userId             String        @unique
  user               User          @relation(fields: [userId], references: [id])
  broadCategory      BroadCategory
  axisScores         Json // { EI, SN, TF, JP }
  pace                String
  groupSizeComfort    Int
  interests           String // JSON 배열 문자열, 예: '["역사","맛집"]'
  budgetLevel         Int
  alcoholComfort      Boolean
  anxietyTriggers     String // JSON 배열 문자열 — 비공개 필드
  languages           String // JSON 배열 문자열
  aiExplanation       String? // Upstage Solar가 생성한 성향 해설 (캐시)
  interestEmbedding   String? // Upstage 임베딩 결과, JSON 배열 문자열 (숫자 벡터)
  createdAt           DateTime      @default(now())
}

model Activity {
  id          String   @id @default(cuid())
  name        String
  description String
  meetups     Meetup[]
}

model Meetup {
  id          String         @id @default(cuid())
  activityId  String
  activity    Activity       @relation(fields: [activityId], references: [id])
  location    String
  scheduledAt DateTime
  minSize     Int            @default(3)
  maxSize     Int            @default(5)
  createdAt   DateTime       @default(now())

  members     MeetupMember[]
  readyRoom   ReadyRoom?
}

model MeetupMember {
  id        String   @id @default(cuid())
  meetupId  String
  meetup    Meetup   @relation(fields: [meetupId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  matchScore Float
  joinedAt  DateTime @default(now())

  @@unique([meetupId, userId])
}

model ReadyRoom {
  id          String          @id @default(cuid())
  meetupId    String          @unique
  meetup      Meetup          @relation(fields: [meetupId], references: [id])
  status      ReadyRoomStatus @default(WAITING)
  expiresAt   DateTime
  createdAt   DateTime        @default(now())

  participants ReadyRoomParticipant[]
}

model ReadyRoomParticipant {
  id          String     @id @default(cuid())
  readyRoomId String
  readyRoom   ReadyRoom  @relation(fields: [readyRoomId], references: [id])
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  readyAt     DateTime?

  @@unique([readyRoomId, userId])
}

model GuideProfile {
  id          String                 @id @default(cuid())
  userId      String                 @unique
  user        User                   @relation(fields: [userId], references: [id])
  status      GuideApplicationStatus @default(PENDING)
  languages   String // JSON 배열 문자열
  region      String
  hourlyRate  Int
  rating      Float                  @default(0)
  bio         String
  createdAt   DateTime               @default(now())

  bookings    GuideBooking[]
}

model GuideBooking {
  id          String        @id @default(cuid())
  guideId     String
  guide       GuideProfile  @relation(fields: [guideId], references: [id])
  travelerId  String
  traveler    User          @relation("TravelerBookings", fields: [travelerId], references: [id])
  status      BookingStatus @default(REQUESTED)
  meetingPlace String
  date        DateTime
  createdAt   DateTime      @default(now())

  payment     Payment?
  review      Review?
}

model Payment {
  id        String        @id @default(cuid())
  bookingId String        @unique
  booking   GuideBooking  @relation(fields: [bookingId], references: [id])
  amount    Int
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
}

model Review {
  id        String       @id @default(cuid())
  bookingId String       @unique
  booking   GuideBooking @relation(fields: [bookingId], references: [id])
  authorId  String
  author    User         @relation("ReviewAuthor", fields: [authorId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime     @default(now())
}

model Report {
  id         String   @id @default(cuid())
  authorId   String
  author     User     @relation("ReportAuthor", fields: [authorId], references: [id])
  targetId   String
  target     User     @relation("ReportTarget", fields: [targetId], references: [id])
  reason     String
  createdAt  DateTime @default(now())
}

model Attraction {
  id          String   @id @default(cuid())
  name        String
  region      String
  category    String // 자연/역사/문화/맛집/액티비티
  description String
  addedById   String
  addedBy     User     @relation(fields: [addedById], references: [id])
  createdAt   DateTime @default(now())

  favorites   AttractionFavorite[]
}

model AttractionFavorite {
  id           String     @id @default(cuid())
  attractionId String
  attraction   Attraction @relation(fields: [attractionId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([attractionId, userId])
}

model AnimalCompanionRequest {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  soloTravel  Boolean  @default(false)
  soloRental  Boolean  @default(false)
  groupTravel Boolean  @default(false)
  groupRental Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id        String    @id @default(cuid())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  title     String
  body      String
  category  String
  createdAt DateTime  @default(now())

  comments  Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Conversation {
  id         String    @id @default(cuid())
  userAId    String
  userA      User      @relation("ConversationUserA", fields: [userAId], references: [id])
  userBId    String
  userB      User      @relation("ConversationUserB", fields: [userBId], references: [id])
  createdAt  DateTime  @default(now())

  messages   Message[]

  @@unique([userAId, userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())
}

model GroupChat {
  id        String   @id @default(cuid())
  name      String
  creatorId String
  creator   User     @relation("GroupChatCreator", fields: [creatorId], references: [id])
  createdAt DateTime @default(now())

  members  GroupChatMember[]
  messages GroupMessage[]
}

model GroupChatMember {
  id          String    @id @default(cuid())
  groupChatId String
  groupChat   GroupChat @relation(fields: [groupChatId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  joinedAt    DateTime  @default(now())

  @@unique([groupChatId, userId])
}

model GroupMessage {
  id          String    @id @default(cuid())
  groupChatId String
  groupChat   GroupChat @relation(fields: [groupChatId], references: [id])
  senderId    String
  sender      User      @relation(fields: [senderId], references: [id])
  body        String
  createdAt   DateTime  @default(now())
}

// 첫 페이지(아싸게임 인트로) 실시간 통계 카드용 로그 테이블
model CheerClick {
  id        String   @id @default(cuid())
  userId    String?
  createdAt DateTime @default(now())
}

model QuestCompletion {
  id        String   @id @default(cuid())
  userId    String
  questType String // 예: "PERSONALITY_TEST"
  createdAt DateTime @default(now())
}

// 루다피아 게임 채팅 — Supabase 클라이언트가 raw SQL로 만든 기존 테이블을 그대로 매핑
// (Prisma로 관리하지 않음: db push가 스키마에 없다는 이유로 삭제하지 않도록 매핑만 유지)
model ChatMessage {
  id         BigInt   @id @default(autoincrement())
  senderName String   @map("sender_name")
  message    String
  isHidden   Boolean  @default(false) @map("is_hidden")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("chat_messages")
}

model ChatReport {
  id            BigInt   @id @default(autoincrement())
  messageId     BigInt?  @map("message_id")
  reporterName  String   @map("reporter_name")
  reason        String
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("chat_reports")
}

// 첫 페이지 통계 카드 — "오늘 새로 여행 시작한 사람" 하루 1명당 1회만 집계하기 위한 방문 로그
model SiteVisit {
  id        String   @id @default(cuid())
  visitorId String
  dateKey   String
  createdAt DateTime @default(now())

  @@unique([visitorId, dateKey])
}

// 아싸던전 — 혼자서도 깰 수 있는 스테이지형 미니 던전. 스테이지 하나당 1회만 클리어 보상 지급.
model DungeonStageProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  stageIndex  Int
  clearedAt   DateTime @default(now())

  @@unique([userId, stageIndex])
}

// 친목도 — 두 유저 사이의 친밀도 점수. userId→otherId 방향으로 한 행씩, 항상 양방향 대칭으로 갱신됨.
// 루다투표제에서 부정투표(참가자와 친한 사람이 봐주기 투표하는 것) 방지에 사용.
model Closeness {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("ClosenessFrom", fields: [userId], references: [id])
  otherId   String
  score     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, otherId])
}

// 오늘의 컨디션 — 다른 유저도 참고할 수 있도록 서버에 저장(기존엔 localStorage에만 있었음)
model UserMood {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  moodKey   String
  updatedAt DateTime @updatedAt
}

// 루다투표제 — AI가 판단하기 애매한 인증(사진 등)을 사람 투표로 넘겨서 결정하는 시스템.
// 위대한 모험 사진 미션(kind="MISSION")과 표정짓기 게임 판정(kind="FACE_OFF") 둘 다 여기서 처리됨.
model RudaVote {
  id           String   @id @default(cuid())
  kind         String // "MISSION" | "FACE_OFF"
  label        String // 투표 카드에 보여줄 제목
  photoAUrl    String
  photoBUrl    String? // FACE_OFF에서 두 번째 사진(팀B)에 사용
  requesterId  String
  requester    User     @relation("RudaVoteRequester", fields: [requesterId], references: [id])
  contextJson  Json // 판정 완료 후 원래 기능에 결과를 반영하기 위한 부가 정보
  status       String   @default("OPEN") // OPEN / APPROVED / REJECTED
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  ballots RudaVoteBallot[]
}

model RudaVoteBallot {
  id        String   @id @default(cuid())
  voteId    String
  vote      RudaVote @relation(fields: [voteId], references: [id])
  voterId   String
  voter     User     @relation(fields: [voterId], references: [id])
  choice    String // MISSION: "APPROVE"/"REJECT"  ·  FACE_OFF: "A"/"B"
  createdAt DateTime @default(now())

  @@unique([voteId, voterId])
}

// 위대한 모험 사진/GPS 미션 진행도 — 유저별로 미션당 몇 번 인증했는지 저장(투표 결과 반영 포함)
model AdventureMissionProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  zoneSlug      String
  missionIndex  Int
  count         Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([userId, zoneSlug, missionIndex])
}

// GPS 사진 인증 퀘스트 — 여행 코스에 들르는 지점을 등록하고, 실제로 그 위치에서
// 사진을 찍어 인증하면(GPS 거리 확인) 점수(QuestCompletion)를 지급함
model QuestCheckpoint {
  id           String   @id @default(cuid())
  name         String
  description  String?
  lat          Float
  lng          Float
  radiusMeters Int      @default(300)
  isOverseas   Boolean  @default(false)
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  verifications QuestCheckpointVerification[]
}

model QuestCheckpointVerification {
  id             String          @id @default(cuid())
  checkpointId   String
  checkpoint     QuestCheckpoint @relation(fields: [checkpointId], references: [id])
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  photoDataUrl   String
  lat            Float
  lng            Float
  distanceMeters Float
  verified       Boolean
  createdAt      DateTime        @default(now())

  @@unique([checkpointId, userId])
}
